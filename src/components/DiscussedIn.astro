---
import Day from './Day.astro';

interface Props {
  articles: { title: string; path: string; published: string }[];
}

// The Articles that cite a Study: from evidence to interpretation.
const { articles } = Astro.props;
---
{articles.length > 0 && (
  <section class="discussed-in" id="discussed-in" aria-labelledby="discussed-in-heading">
    <h2 id="discussed-in-heading">Discussed in</h2>
    <ul>
      {articles.map(({ title, path, published }) => (
        <li><a href={path}>{title}</a>, <Day date={published} /></li>
      ))}
    </ul>
  </section>
)}
