---
import { TURNSTILE_SITE_KEY, WAITLISTS, WAITLIST_ENDPOINT } from '../../site.config.mjs';
import script from '../lib/waitlist-form.js?raw';
import { uiAt } from '../lib/ui';
import '../styles/waitlist.css';

interface Props {
  /** The Waitlist's `source`, a key of WAITLISTS. */
  source: keyof typeof WAITLISTS;
}

const { source } = Astro.props;
const name = WAITLISTS[source];
const words = uiAt(Astro.url).waitlist;
---
<section class="waitlist" id="waitlist" aria-labelledby="waitlist-heading">
  <h2 id="waitlist-heading">{words.heading}</h2>
  <p>{words.intro(name)}</p>
  <form class="waitlist-form" method="post" action={WAITLIST_ENDPOINT} data-waitlist data-messages={JSON.stringify(words.messages)}>
    <input type="hidden" name="source" value={source} />
    <fieldset disabled>
      <div class="waitlist-field">
        <label for="waitlist-email">{words.email}</label>
        <input
          id="waitlist-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
        />
      </div>
      <div class="waitlist-consent">
        <input id="waitlist-consent" type="checkbox" name="consent" value="yes" required />
        <label for="waitlist-consent">{words.consent(name)}</label>
      </div>
      <p class="waitlist-note">
        {words.note.before}<a href="/privacy/">{words.note.link}</a>{words.note.after}
      </p>
      <div
        class="cf-turnstile"
        data-sitekey={TURNSTILE_SITE_KEY}
        data-callback="waitlistBotCheckPassed"
        data-error-callback="waitlistBotCheckFailed"
      ></div>
      <button type="submit">{words.submit}</button>
    </fieldset>
    <noscript><p class="waitlist-note">{words.noscript}</p></noscript>
    <p class="waitlist-status" id="waitlist-status" role="status" aria-live="polite"></p>
  </form>
</section>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer data-waitlist></script>
<script is:inline type="module" data-waitlist set:html={script} />
