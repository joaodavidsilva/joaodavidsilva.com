---
import type { StudyLink } from '../lib/studies';
import { uiAt } from '../lib/ui';

interface Props {
  data: StudyLink[];
  scripts: StudyLink[];
}

// What a Study's evidence can be checked or reproduced with.
const { data, scripts } = Astro.props;
const ui = uiAt(Astro.url);
const groups = [
  [ui.data, data],
  [ui.scripts, scripts],
] as const;
---
{(data.length > 0 || scripts.length > 0) && (
  <section class="attachments" id="data-and-scripts" aria-labelledby="data-and-scripts-heading">
    <h2 id="data-and-scripts-heading">{ui.dataAndScripts}</h2>
    {groups.map(([label, links]) => links.length > 0 && (
      <>
        <h3>{label}</h3>
        <ul>
          {links.map(({ title, href, description }) => (
            <li>{description ? <><a href={href} download>{title}</a> ({description})</> : <a href={href}>{title}</a>}</li>
          ))}
        </ul>
      </>
    ))}
  </section>
)}
