---
import type { Link, Position } from '../lib/series';
import { languageOfPath } from '../lib/translations';
import { uiAt } from '../lib/ui';

interface Props {
  position: Position;
}

// The previous and next parts of a Series, after the body of a part; a part without a
// Translation in the page's language links its English Original, marked as such.
const { position } = Astro.props;
const { previous, next } = position;
const ui = uiAt(Astro.url);
const language = languageOfPath(Astro.url.pathname);
const links = [
  ['previous', 'prev', ui.previous, previous],
  ['next', 'next', ui.next, next],
] as const;
const hreflangOf = (link: Link) => (link.language === language ? undefined : link.language);
---
{(previous || next) && (
  <nav class="series-nav" aria-label={`${ui.series}: ${position.series.title}`}>
    <ul>
      {links.map(([kind, rel, label, link]) => link && (
        <li class={kind}>
          <a href={link.path} hreflang={hreflangOf(link)} rel={rel}>{label}: {link.title}</a>{hreflangOf(link) && ` ${ui.inEnglish}`}
        </li>
      ))}
    </ul>
  </nav>
)}
