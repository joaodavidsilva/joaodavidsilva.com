---
import { uiAt } from '../lib/ui';

interface Props {
  links: { network: string; href: string }[];
}

// Where the conversation about a piece happens; rendered only when a link is set.
const { links } = Astro.props;
const ui = uiAt(Astro.url);
---
{links.length > 0 && (
  <ul class="discuss">
    {links.map(({ network, href }) => (
      <li><a href={href}>{ui.discussOn(network)}</a></li>
    ))}
  </ul>
)}
