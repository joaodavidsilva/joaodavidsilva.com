---
import type { Position } from '../lib/series';
import { languageOfPath } from '../lib/translations';
import { uiAt } from '../lib/ui';

interface Props {
  position: Position;
}

// "Part N of M · <Series>", above the title of a part of a Series.
const { position } = Astro.props;
const ui = uiAt(Astro.url);
const english = position.series.language !== languageOfPath(Astro.url.pathname);
---
<p class="series-position">{ui.part(position.part, position.of)} · <a href={position.series.path} hreflang={english ? position.series.language : undefined}>{position.series.title}</a>{english && ` ${ui.inEnglish}`}</p>
