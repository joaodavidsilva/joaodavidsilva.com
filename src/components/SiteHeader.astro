---
import { getNow } from '../lib/now';
import { getRecord } from '../lib/record';
import { sectionPathIn } from '../lib/sections';
import type { Language } from '../lib/translations';
import { uiOf } from '../lib/ui';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const ui = uiOf(language);
const sections: (keyof typeof ui.sections)[] = ['writing', 'research', 'knowledge', 'projects'];
if (await getNow()) sections.push('now');
if (await getRecord()) sections.push('about');
const items = await Promise.all(
  sections.map(async (section) => ({
    label: ui.sections[section],
    href: await sectionPathIn(section, `/${section}/`, language),
  })),
);
const home = await sectionPathIn('home', '/', language);
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="site-header-inner container">
    <a class="site-name" href={home}><span class="site-mark" aria-hidden="true"></span>João David Silva</a>
    <button
      class="menu-button"
      type="button"
      data-menu
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-label={ui.menu}
      data-close-label={ui.close}
    ><span data-menu-label>{ui.menu}</span></button>
    <nav class="site-nav" id="site-nav" aria-label={ui.sectionsLabel}>
      <ul>
        {items.map(({ label, href }) => (
          <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="header-contact" data-hcontact href="mailto:me@joaodavidsilva.com">{ui.contact}</a>
  </div>
  <script is:inline data-menu-script>
    (() => {
      const header = document.querySelector('.site-header');
      const button = header?.querySelector('[data-menu]');
      const nav = header?.querySelector('.site-nav');
      const contact = header?.querySelector('[data-hcontact]');
      if (!header || !button || !nav) return;
      const label = button.querySelector('[data-menu-label]');
      const setOpen = (open) => {
        header.dataset.open = String(open);
        button.setAttribute('aria-expanded', String(open));
        if (label) label.textContent = open ? button.dataset.closeLabel : button.dataset.menuLabel;
      };
      const mobile = matchMedia('(max-width: 820px)');
      mobile.addEventListener('change', (event) => {
        if (!event.matches) setOpen(false);
      });
      button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
      nav.addEventListener('click', (event) => {
        if (event.target.closest('a')) setOpen(false);
      });
      contact?.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          button.focus();
        }
      });
    })();
  </script>
</header>
