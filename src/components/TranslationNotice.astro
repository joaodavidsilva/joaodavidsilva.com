---
import type { Language, Translations } from '../lib/translations';
import { uiOf } from '../lib/ui';
import '../styles/translations.css';

interface Props {
  translations: Translations;
  /** The language of the current page. */
  language: Language;
}

// One muted note after the language links, combining the AI label and the outdated status.
// Portuguese carries no AI label and reads its note in Portuguese; any other Translation is
// labelled "Translated by AI", in English like its note, since no one reviewed the language.
const { translations, language } = Astro.props;
const { original, ai, outdated } = translations;
const ui = uiOf(language);
const words = ai && outdated ? ui.translationNotice.aiOutdated : ai ? ui.translationNotice.ai : ui.translationNotice.outdated;
const noteLanguage = ui.locale.split('-')[0];
---
{original && (ai || outdated) && (
  <p class={outdated ? 'translation-note outdated' : 'translation-note'} role="note" lang={noteLanguage === language ? undefined : noteLanguage}>
    {words.before}<a href={original.path} hreflang={original.language}>{words.link}</a>{words.after}
  </p>
)}
