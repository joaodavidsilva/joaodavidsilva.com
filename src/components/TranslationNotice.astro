---
import type { Language, Translations } from '../lib/translations';
import '../styles/translations.css';

interface Props {
  translations: Translations;
  /** The language of the current page. */
  language: Language;
}

// Portuguese carries no label and reads its notice in Portuguese; any other Translation is
// labelled "Translated by AI", in English like its notice, since no one reviewed the language.
const { translations, language } = Astro.props;
const { original, ai, outdated } = translations;
---
{original && ai && (
  <p class="translation-label" lang="en">
    Translated by AI from the <a href={original.path} hreflang={original.language}>English original</a>.
  </p>
)}
{original && outdated && (language === 'pt' ? (
  <p class="outdated-translation" role="note">
    O original desta página mudou desde que foi traduzida. <a href={original.path} hreflang={original.language}>Leia o original em inglês</a>.
  </p>
) : (
  <p class="outdated-translation" role="note" lang="en">
    The original of this page has changed since it was translated. <a href={original.path} hreflang={original.language}>Read the original in English</a>.
  </p>
))}
