---
import type { Language, Translations } from '../lib/translations';
import { uiOf } from '../lib/ui';
import '../styles/translations.css';

interface Props {
  translations: Translations;
  /** The language of the current page. */
  language: Language;
}

// Offers only the languages the page exists in; shown only when there is more than one.
const { translations, language } = Astro.props;
---
{translations.alternates.length > 1 && (
  <nav class="language-switcher" aria-label={uiOf(language).languages}>
    <ul>
      {translations.alternates.map((alternate) => (
        <li>
          <a
            href={alternate.path}
            hreflang={alternate.language}
            lang={alternate.language}
            aria-current={alternate.language === language ? 'page' : undefined}
          >{alternate.name}</a>
        </li>
      ))}
    </ul>
  </nav>
)}
