---
import type { Translations } from '../lib/translations';
import '../styles/translations.css';

interface Props {
  translations: Translations;
  /** The language of the current page. */
  language: string;
}

// Offers only the languages the page exists in; shown only when there is more than one.
const { translations, language } = Astro.props;
const label = language === 'pt' ? 'Idiomas' : 'Languages';
---
{translations.versions.length > 1 && (
  <nav class="language-switcher" aria-label={label}>
    <ul>
      {translations.versions.map((version) => (
        <li>
          <a
            href={version.path}
            hreflang={version.language}
            lang={version.language}
            aria-current={version.language === language ? 'page' : undefined}
          >{version.name}</a>
        </li>
      ))}
    </ul>
  </nav>
)}
