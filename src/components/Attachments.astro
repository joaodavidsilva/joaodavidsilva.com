---
import type { Attachment } from '../lib/articles';
import { uiAt } from '../lib/ui';

interface Props {
  attachments: Attachment[];
}

const { attachments } = Astro.props;
const ui = uiAt(Astro.url);
---
{attachments.length > 0 && (
  <section class="attachments" aria-labelledby="attachments-heading">
    <h2 id="attachments-heading">{ui.attachments}</h2>
    <ul>
      {attachments.map(({ title, path, file, description }) => (
        <li><a href={path} download={file}>{title}</a> ({description})</li>
      ))}
    </ul>
  </section>
)}
