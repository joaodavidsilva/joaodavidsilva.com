---
import { render } from 'astro:content';
import Day from './Day.astro';
import { homeOf, type Piece } from '../lib/home';
import type { Language } from '../lib/translations';
import { uiOf } from '../lib/ui';

interface Props {
  language: Language;
}

// The home page's sections in its language: only what exists in that language is listed.
// Lists share the index pages' markup and styles: title as a heading, meta line below it.
const { language } = Astro.props;
const ui = uiOf(language);
const { now, featured, recent, active } = await homeOf(language);
const NowBody = now && (await render(now.entry)).Content;
---
{now && NowBody && (
  <section id="now" class="home-now">
    <h2><a href={now.path}>{ui.now.title}</a></h2>
    <p class="piece-meta"><span>{ui.updated} <Day date={now.date} /></span></p>
    <NowBody />
  </section>
)}
{[['featured', ui.featured, featured], ['recent', ui.recent, recent]].map(([id, title, pieces]) =>
  (pieces as Piece[]).length > 0 && (
    <section id={id as string}>
      <h2>{title}</h2>
      <ul class="piece-list">
        {(pieces as Piece[]).map((p) => (
          <li>
            <article>
              <h3><a href={p.path}>{p.title}</a></h3>
              <p class="piece-meta"><span>{p.type}</span> <Day date={p.published} /></p>
              <p>{p.summary}</p>
            </article>
          </li>
        ))}
      </ul>
    </section>
  ),
)}
{active.length > 0 && (
  <section id="projects">
    <h2>{ui.activeProjects}</h2>
    <ul class="piece-list">
      {active.map((p) => (
        <li>
          <h3><a href={p.path}>{p.name}</a></h3>
          {p.version && <p class="piece-meta">{ui.version} {p.version}</p>}
          <p>{p.oneLine}</p>
        </li>
      ))}
    </ul>
  </section>
)}
