---
import { render } from 'astro:content';
import { homeOf, type Piece } from '../lib/home';
import type { Language } from '../lib/translations';
import { uiOf } from '../lib/ui';

interface Props {
  language: Language;
}

// The home page's sections in its language: only what exists in that language is listed.
const { language } = Astro.props;
const ui = uiOf(language);
const { now, featured, recent, active } = await homeOf(language);
const NowBody = now && (await render(now.entry)).Content;
---
{now && NowBody && (
  <section id="now" class="home-now">
    <h2><a href={now.path}>{ui.now.title}</a></h2>
    <p class="home-meta">{ui.updated} <time datetime={now.date}>{now.date}</time></p>
    <NowBody />
  </section>
)}
{[['featured', ui.featured, featured], ['recent', ui.recent, recent]].map(([id, title, pieces]) =>
  (pieces as Piece[]).length > 0 && (
    <section id={id as string}>
      <h2>{title}</h2>
      <ul class="home-list">
        {(pieces as Piece[]).map((p) => (
          <li>
            <p class="home-meta">{p.type} · <time datetime={p.published}>{p.published}</time></p>
            <a href={p.path}>{p.title}</a>
            <p>{p.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  ),
)}
{active.length > 0 && (
  <section id="projects">
    <h2>{ui.activeProjects}</h2>
    <ul class="home-list">
      {active.map((p) => (
        <li>
          <a href={p.path}>{p.name}</a>{p.version && <span class="home-meta"> · {ui.version} {p.version}</span>}
          <p>{p.oneLine}</p>
        </li>
      ))}
    </ul>
  </section>
)}
<style>
  .home-list { list-style: none; padding: 0; }
  .home-list p { margin-block: 0.25rem; }
  .home-meta { color: var(--ink-muted); }
</style>
