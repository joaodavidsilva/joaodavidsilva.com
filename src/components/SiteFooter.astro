---
import { REPO_URL } from '../../site.config.mjs';
import type { Language } from '../lib/translations';
import { uiOf } from '../lib/ui';

interface Props {
  language: Language;
  /** The feed in the page's language, or the English one. */
  feed: string;
}

const { language, feed } = Astro.props;
const ui = uiOf(language);
const built = new Date();
const builtDate = built.toISOString().slice(0, 10);
const builtLabel = built.toLocaleDateString(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<footer class="site-footer">
  <ul>
    <li><a href={feed}>{ui.feed}</a></li>
    <li><a href="/llms.txt">llms.txt</a></li>
    <li><a href="https://github.com/joaodavidsilva" rel="me">GitHub</a></li>
    <li><a href="https://www.linkedin.com/in/joaodavidsilvaa/" rel="me">LinkedIn</a></li>
    <li><a href="https://x.com/joaodavidsilvaa" rel="me">X</a></li>
    <li><a href="mailto:me@joaodavidsilva.com">me@joaodavidsilva.com</a></li>
  </ul>
  <p>
    {ui.licence.content} <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>,
    {ui.licence.code} <a href={`${REPO_URL}/blob/main/LICENSE`}>{ui.licence.mit}</a>.
    {ui.licence.built} <time datetime={builtDate}>{builtLabel}</time>.
  </p>
</footer>
