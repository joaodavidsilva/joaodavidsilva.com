---
import Base from './Base.astro';
import SuggestCorrection from '../components/SuggestCorrection.astro';
import { SITE_URL } from '../../site.config.mjs';
import { jsonLdBase } from '../lib/metadata';
import { renderProjectBody } from '../lib/project-body';
import { inlineMarkdown } from '../lib/inline-markdown';
import { figuresOf, legalOf, linksOf, metadataOf, projectsIndexOf, twinPathOf, type Project } from '../lib/projects';
import { translationJsonLd, type Translations } from '../lib/translations';
import { uiOf } from '../lib/ui';
import '../styles/projects.css';

interface Props {
  project: Project;
  translations: Translations;
}

const { project, translations } = Astro.props;
const meta = metadataOf(project);
const ui = uiOf(meta.language);
const links = linksOf(project, ui);
const legal = await legalOf(project);
const figures = await figuresOf(project);
const body = await renderProjectBody(project);
const index = projectsIndexOf(meta.language);
const customVersion = project.data.facts.some((fact) => fact.label === ui.version);
const { software } = project.data;

// An application is described as one; any other Project as the page about it.
const type = software ? 'SoftwareApplication' : 'WebPage';
const jsonLd = {
  ...jsonLdBase(type, meta),
  ...(software && {
    applicationCategory: software.category,
    operatingSystem: software.operatingSystems.join(', '),
    softwareVersion: meta.version,
    sameAs: links.map((link) => link.url),
    screenshot: figures.map((figure) => new URL(figure.src, SITE_URL).href),
  }),
  ...translationJsonLd(translations, type),
};
---
<Base
  title={meta.title}
  description={meta.summary}
  canonical={meta.canonical}
  language={meta.language}
  twin={twinPathOf(project)}
  translations={translations}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="project container">
    <nav class="breadcrumb" aria-label={index.title}>
      <a href={index.path}>{index.title}</a><span aria-hidden="true">/</span><span>{meta.title}</span>
    </nav>
    <header class="project-header">
      <div class="project-hero">
        <h1 class="project-title">{meta.title}</h1>
        <p class="project-tagline">{meta.summary}</p>
        {links.length > 0 && (
          <nav class="cta-row" aria-label={ui.links}>
            {links.map((link, i) => <a class:list={['button', i === 0 ? 'button--primary' : 'button--secondary']} href={link.url}>{link.label} ↗</a>)}
          </nav>
        )}
      </div>
      <dl class="facts project-facts">
        <div><dt>{ui.status}</dt><dd>{ui.projectStatus[meta.status]}</dd></div>
        {meta.version && !customVersion && <div><dt>{ui.version}</dt><dd>{meta.version}</dd></div>}
        {project.data.facts.map((fact) => <div><dt>{fact.label}</dt><dd><Fragment set:html={inlineMarkdown(fact.value)} /></dd></div>)}
        {legal.length > 0 && (
          <div><dt>{ui.redesign.projects.legal}</dt><dd class="project-legal">
            {legal.map((doc, i) => <>{i > 0 && ' · '}<a href={doc.path} hreflang={doc.language === meta.language ? undefined : doc.language}>{doc.title}</a>{doc.language !== meta.language && ` ${ui.inEnglish}`}</>)}
          </dd></div>
        )}
      </dl>
    </header>
    {figures.length > 0 && (
      <div class="project-screenshots band">
        <div class="screenshots">
          {figures.map((figure) => (
            <figure>
              <img src={figure.src} {...figure.attributes} alt={figure.alt} />
              {figure.caption && <figcaption>{figure.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    )}
    <div class="project-body"><Fragment set:html={body} /></div>
    <SuggestCorrection title={meta.title} canonical={meta.canonical}>
      <p><a href={twinPathOf(project)}>{ui.redesign.readAsMarkdown}</a></p>
      <p><a href={index.path}>{ui.redesign.allProjects}</a></p>
    </SuggestCorrection>
  </article>
</Base>
