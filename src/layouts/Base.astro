---
import { Font } from 'astro:assets';
import { FEED_PATH } from '../../site.config.mjs';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import '../styles/chrome.css';
import '../styles/long-form.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  language: string;
  /** Path of the page's Markdown twin. */
  twin: string;
}

const { title, description, canonical, language, twin } = Astro.props;
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · João David Silva</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={twin} />
    <link rel="alternate" type="application/atom+xml" title="João David Silva" href={FEED_PATH} />
    <Font cssVariable="--font-serif" preload={[{ subset: 'latin', style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
