---
import { Font } from 'astro:assets';
import { FEED_PATH } from '../../site.config.mjs';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import TranslationNotice from '../components/TranslationNotice.astro';
import { sectionPathIn } from '../lib/sections';
import type { Language, Translations } from '../lib/translations';
import themeScript from '../lib/theme-script.js?raw';
import '../styles/global.css';
import '../styles/chrome.css';
import '../styles/long-form.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  language: Language;
  /** Path of the page's Markdown twin. */
  twin: string;
  /** The languages the page exists in; drives hreflang, the switcher and the translation notices. */
  translations?: Translations;
}

const { title, description, canonical, language, twin, translations } = Astro.props;
const alternates = translations && translations.alternates.length > 1 ? translations.alternates : [];
const feed = await sectionPathIn('feed', FEED_PATH, language);
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline data-theme-script set:html={themeScript} />
    <title>{title} · João David Silva</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={twin} />
    <link rel="alternate" type="application/atom+xml" title="João David Silva" href={feed} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.language} href={alternate.canonical} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].canonical} />}
    <Font cssVariable="--font-serif" preload={[{ subset: 'latin', style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <SiteHeader language={language} />
    <main>
      {alternates.length > 0 && translations && (
        <div class="translation-chrome">
          <LanguageSwitcher translations={translations} language={language} />
          <TranslationNotice translations={translations} language={language} />
        </div>
      )}
      <slot />
    </main>
    <SiteFooter language={language} feed={feed} />
  </body>
</html>
