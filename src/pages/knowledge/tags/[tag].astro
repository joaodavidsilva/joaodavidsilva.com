---
import Base from '../../../layouts/Base.astro';
import KnowledgeList from '../../../components/KnowledgeList.astro';
import { getKnowledge, slugify, tagsOf, type KnowledgeEntry } from '../../../lib/knowledge';
import { SITE_URL } from '../../../../site.config.mjs';

export async function getStaticPaths() {
  const entries = await getKnowledge();
  return tagsOf(entries).map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, entries: entries.filter(({ entry }) => entry.data.tags.includes(tag)) },
  }));
}

const { tag, entries } = Astro.props as { tag: string; entries: KnowledgeEntry[] };
const path = `/knowledge/tags/${slugify(tag)}/`;
const summary = `Knowledge Base entries tagged “${tag}”.`;
---
<Base title={`Knowledge: ${tag}`} description={summary} canonical={new URL(path, SITE_URL).href} language="en" twin={`${path.slice(0, -1)}.md`}>
  <header>
    <h1>Knowledge tagged “{tag}”</h1>
    <p><a href="/knowledge/">All entries by category</a></p>
  </header>
  <KnowledgeList entries={entries} />
</Base>
