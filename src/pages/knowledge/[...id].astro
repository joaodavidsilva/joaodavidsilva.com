---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SuggestCorrection from '../../components/SuggestCorrection.astro';
import {
  canonicalOf, categoryIdOf, getKnowledge, pathOf, tagPathOf, twinPathOf, type KnowledgeEntry,
} from '../../lib/knowledge';

export async function getStaticPaths() {
  return (await getKnowledge()).map((item) => ({ params: { id: item.entry.id }, props: { item } }));
}

const { item } = Astro.props as { item: KnowledgeEntry };
const { entry, related, skillUrl, updated } = item;
const { title, summary, kind, category, tags, language } = entry.data;
const canonical = canonicalOf(entry);
const { Content } = await render(entry);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': kind === 'concept' ? 'DefinedTerm' : 'TechArticle',
  name: title,
  headline: title,
  description: summary,
  dateModified: updated,
  inLanguage: language,
  keywords: tags,
  about: category,
  url: canonical,
};
---
<Base title={title} description={summary} canonical={canonical} language={language} twin={twinPathOf(entry)}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <header>
      <p>{kind === 'concept' ? 'Concept' : 'Guide'} · <a href={`/knowledge/#${categoryIdOf(category)}`}>{category}</a></p>
      <h1>{title}</h1>
      <p>{summary}</p>
      <p>Last updated <time datetime={updated}>{updated}</time></p>
    </header>
    <Content />
    {skillUrl && (
      <aside aria-label="Skill">
        <p>Give this practice to your agent: <a href={skillUrl}>the <code>{entry.data.skill}</code> Skill</a>.</p>
      </aside>
    )}
    {related.length > 0 && (
      <nav aria-label="Related entries">
        <h2>Related</h2>
        <ul>{related.map((target) => <li><a href={pathOf(target)}>{target.data.title}</a></li>)}</ul>
      </nav>
    )}
    {tags.length > 0 && (
      <ul class="knowledge-tags" aria-label="Tags">
        {tags.map((tag) => <li><a href={tagPathOf(tag)}>{tag}</a></li>)}
      </ul>
    )}
    <SuggestCorrection title={title} canonical={canonical} />
  </article>
</Base>
