---
import Base from '../../../layouts/Base.astro';
import { getArticles, metadataOf, pathOf, writingIndexOf } from '../../../lib/articles';
import { dayWithoutYear } from '../../../lib/long-form';
import { byYear, jsonLdBase } from '../../../lib/metadata';
import { readingMinutesOf } from '../../../lib/own-folder';
import { languageParams, languagesOfSection, sectionPathIn } from '../../../lib/sections';
import { getSeries, metadataOf as seriesMetadataOf, pathOf as seriesPathOf } from '../../../lib/series';
import { generatedTranslations, type Language } from '../../../lib/translations';
import { uiOf } from '../../../lib/ui';
import { FEED_PATH } from '../../../../site.config.mjs';

export const getStaticPaths = () => languageParams('writing');

const { language } = Astro.props as { language: Language };
const ui = uiOf(language);
const index = writingIndexOf(language);
const articles = (await getArticles(language)).map((article) => ({
  path: pathOf(article),
  readingMinutes: readingMinutesOf(article),
  ...metadataOf(article),
}));
const series = (await getSeries(language))
  .filter(({ entry }) => entry.data.language === language)
  .map((one) => ({ path: seriesPathOf(one), parts: one.parts.length, ...seriesMetadataOf(one) }));
const translations = generatedTranslations('/writing/', await languagesOfSection('writing'));
const feed = await sectionPathIn('feed', FEED_PATH, language);
const jsonLd = {
  ...jsonLdBase('CollectionPage', {
    ...index,
    language,
    published: articles.at(-1)?.published,
    updated: articles.map((a) => a.updated).sort().at(-1),
  }),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((article, i) => ({ '@type': 'ListItem', position: i + 1, url: article.canonical, name: article.title })),
  },
};
---
<Base title={index.title} description={index.summary} canonical={index.canonical} language={language} twin={index.twin} translations={translations}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="index-page container long-form-index">
    <header>
      <p class="eyebrow">{index.title}</p>
      <h1 class="page-title">{ui.redesign.writing.title}</h1>
      <p class="lede">{ui.redesign.writing.lede}</p>
    </header>
    {articles.length > 0 ? (
      byYear(articles).map(([year, inYear]) => (
        <section class="year labelled-row labelled-row--group" aria-labelledby={`year-${year}`}>
          <h2 class="row-label" id={`year-${year}`}>{year}</h2>
          <ol class="piece-list row-content" reversed>
            {inYear.map(({ path, title, summary, published, featured, tags, readingMinutes }) => (
              <li>
                <article>
                  <p class="piece-meta">
                    <span><time datetime={published}>{dayWithoutYear(published, ui.locale)}</time> · {ui.minRead(readingMinutes)}</span>
                    {featured && <span>{ui.featured}</span>}
                  </p>
                  <h3><a href={path}>{title}</a></h3>
                  <p class="piece-summary">{summary}</p>
                  {tags && tags.length > 0 && (
                    <ul class="tags" aria-label={ui.tags}>
                      {tags.map((tag) => <li>#{tag}</li>)}
                    </ul>
                  )}
                </article>
              </li>
            ))}
          </ol>
        </section>
      ))
    ) : (
      <section class="labelled-row labelled-row--group" aria-labelledby="articles-heading">
        <h2 class="row-label" id="articles-heading">{index.title}</h2>
        <p class="row-content empty-state">{ui.noArticles}</p>
      </section>
    )}
    {series.length > 0 && (
      <section class="series-list labelled-row labelled-row--rule" aria-labelledby="series-heading">
        <h2 class="row-label" id="series-heading">{ui.series}</h2>
        <ul class="piece-list row-content">
          {series.map(({ path, title, summary, status, parts }) => (
            <li>
              <h3><a href={path}>{title}</a></h3>
              <p class="piece-meta">
                <span>{ui.seriesStatus[status]}</span>
                <span>{ui.parts(parts)}</span>
              </p>
              <p>{summary}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
    <p class="feed-note">{ui.redesign.writing.feedBefore}<a href={feed}>{ui.feed}</a>{ui.redesign.writing.feedAfter}</p>
  </div>
</Base>
