---
import Base from '../../../layouts/Base.astro';
import KnowledgeSearch from '../../../components/KnowledgeSearch.astro';
import KnowledgeList from '../../../components/KnowledgeList.astro';
import {
  byCategory, getKnowledge, indexMetadataOf, knowledgeIndexOf, listingJsonLd, tagPathOf, tagsOf,
} from '../../../lib/knowledge';
import { languageParams, languagesOfSection } from '../../../lib/sections';
import { generatedTranslations, type Language } from '../../../lib/translations';
import { uiOf } from '../../../lib/ui';
import '../../../styles/knowledge.css';

export const getStaticPaths = () => languageParams('knowledge');

const { language } = Astro.props as { language: Language };
const ui = uiOf(language);
const index = knowledgeIndexOf(language);
const entries = await getKnowledge(language);
const groups = byCategory(entries);
const tags = tagsOf(entries, language);
const translations = generatedTranslations('/knowledge/', await languagesOfSection('knowledge'));
const jsonLd = listingJsonLd(indexMetadataOf(language, entries), entries);
---
<Base title={index.title} description={index.summary} canonical={index.canonical} language={language} twin={index.twin} translations={translations}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="container index-page knowledge-index">
    <header class="knowledge-header">
      <p class="eyebrow">{index.title}</p>
      <h1 class="page-title">{ui.redesign.knowledge.title}</h1>
      <p class="lede">{ui.redesign.knowledge.lede}</p>
    </header>
    {entries.length > 0 ? (
      <>
        <KnowledgeSearch initialCount={ui.redesign.knowledge.summary(entries.length, groups.length)} />
        {/* The search's results replace this index while a query is present. */}
        <div data-knowledge-index>
          {groups.map((group) => (
            <section class="labelled-row labelled-row--group knowledge-category" aria-labelledby={group.id}>
              <div class="row-label">
                <h2 id={group.id}>{group.category}</h2>
                <p class="entry-count">{ui.redesign.entryCount(group.entries.length)}</p>
              </div>
              <div class="row-content">
                <KnowledgeList entries={group.entries} heading="h3" rows />
              </div>
            </section>
          ))}
          {tags.length > 0 && (
            <nav class="labelled-row labelled-row--rule knowledge-tags" aria-labelledby="knowledge-tags">
              <div class="row-label"><h2 class="eyebrow" id="knowledge-tags">{ui.redesign.knowledge.tags}</h2></div>
              <ul class="row-content knowledge-tag-list">
                {tags.map((tag) => <li><a class="pill" href={tagPathOf(tag, language)}>#{tag}</a></li>)}
              </ul>
            </nav>
          )}
        </div>
      </>
    ) : (
      <p class="knowledge-empty">{ui.noKnowledge}</p>
    )}
  </div>
</Base>
