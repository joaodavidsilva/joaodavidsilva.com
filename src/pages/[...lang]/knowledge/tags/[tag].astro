---
import Base from '../../../../layouts/Base.astro';
import KnowledgeList from '../../../../components/KnowledgeList.astro';
import type { KnowledgeEntry } from '../../../../lib/knowledge';
import { tagPathOf } from '../../../../lib/knowledge';
import { tagRoutes } from '../../../../lib/routes';
import { absolute, pathIn, twinOf, type Language } from '../../../../lib/translations';
import { uiOf } from '../../../../lib/ui';

export const getStaticPaths = tagRoutes;

const { tag, language, entries } = Astro.props as { tag: string; language: Language; entries: KnowledgeEntry[] };
const ui = uiOf(language);
const path = tagPathOf(tag, language);
---
<Base title={`${ui.knowledge.title}: ${tag}`} description={ui.taggedSummary(tag)} canonical={absolute(path)} language={language} twin={twinOf(path)}>
  <header>
    <h1>{ui.tagged(tag)}</h1>
    <p><a href={pathIn('/knowledge/', language)}>{ui.allEntries}</a></p>
  </header>
  <KnowledgeList entries={entries} />
</Base>
