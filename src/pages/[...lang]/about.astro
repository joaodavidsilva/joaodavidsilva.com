---
import Base from '../../layouts/Base.astro';
import SuggestCorrection from '../../components/SuggestCorrection.astro';
import { escapeMarkup as escape } from '../../lib/escape';
import {
  ABOUT_PATH, CV_PATHS, cvFileName, hostPath, hrefOf, pageTitles, paragraphsOf, periodOf, personOf, type ProfessionalRecord, type Source,
} from '../../lib/record';
import { aboutRoutes } from '../../lib/routes';
import { alternateAt, type Translations } from '../../lib/translations';
import { uiOf } from '../../lib/ui';
import '../../styles/about.css';

// Exists only when the content set has a record, in each language it is translated into.
export const getStaticPaths = aboutRoutes;

const { record, translations } = Astro.props as { record: ProfessionalRecord; translations: Translations };
const { language } = record;
const ui = uiOf(language);
const words = ui.record;
const page = alternateAt(ABOUT_PATH, language);
const person = personOf(record);
const titles = await pageTitles();
// One Claim's source, as a trailing note; attested Claims are labelled so readers know only João can confirm them.
const src = (source: Source) =>
  `<span class="source-note">${
    'attested' in source
      ? `(<span class="attested">${words.attested}</span>: ${escape(source.attested)})`
      : `(<a href="${escape(hrefOf(source))}">${words.source}</a>)`
  }</span>`;
---
<Base title={ui.about} description={`${record.name}. ${record.headline}`} canonical={page.canonical} language={language} twin={page.twin} translations={translations}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <article class="record">
    <header>
      <h1>{ui.about}</h1>
      <p>{record.name}. {record.headline}</p>
      {record.location && <p>{record.location}</p>}
      <p class="cv">{words.downloadCv} <a href={CV_PATHS.pdf} download={cvFileName(record, 'pdf')}>PDF</a>, <a href={CV_PATHS.docx} download={cvFileName(record, 'docx')}>DOCX</a></p>
    </header>
    {[[words.interests, record.interests], [words.approach, record.approach]].map(([title, prose]) => {
      const paragraphs = paragraphsOf(prose);
      return paragraphs.length > 0 && <section><h2>{title}</h2>{paragraphs.map((p) => <p>{p}</p>)}</section>;
    })}
    {record.roles.length > 0 && (
      <section><h2>{words.roles}</h2><ul>
        {record.roles.map((r) => (
          <li>{r.title} · {r.organisation} · <span class="period">{periodOf(r, ui)}</span> <Fragment set:html={src(r.source)} />
            {r.highlights.length > 0 && <ul>{r.highlights.map((h) => <li>{h}</li>)}</ul>}
          </li>
        ))}
      </ul></section>
    )}
    {record.projects.length > 0 && (
      <section><h2>{words.projects}</h2><ul>
        {record.projects.map((p) => <li>{p.url ? <a href={p.url}>{p.name}</a> : p.name}: {p.summary} <Fragment set:html={src(p.source)} /></li>)}
      </ul></section>
    )}
    {record.skills.length > 0 && (
      <section><h2>{words.skills}</h2><ul>
        {record.skills.map((s) => (
          <li>{s.name}, {words.demonstratedIn} {s.demonstrated.map((d, i) => (
            <>{i > 0 && ', '}<a href={hrefOf(d)}>{'page' in d ? (titles.get(d.page) ?? d.page) : hostPath(d.url)}</a></>
          ))}</li>
        ))}
      </ul></section>
    )}
    {record.achievements.length > 0 && (
      <section><h2>{words.achievements}</h2><ul>
        {record.achievements.map((a) => <li>{a.text} <Fragment set:html={src(a.source)} /></li>)}
      </ul></section>
    )}
    {record.publications.length > 0 && (
      <section><h2>{words.publications}</h2><ul>
        {record.publications.map((p) => <li>{p.url ? <a href={p.url}>{p.title}</a> : p.title} <Fragment set:html={src(p.source)} /></li>)}
      </ul></section>
    )}
    {record.contributions.length > 0 && (
      <section><h2>{words.contributions}</h2><ul>
        {record.contributions.map((c) => <li>{c.text} <Fragment set:html={src(c.source)} /></li>)}
      </ul></section>
    )}
    {record.languages.length > 0 && (
      <section><h2>{words.languages}</h2><ul>{record.languages.map((l) => <li>{l}</li>)}</ul></section>
    )}
    {record.sameAs.length > 0 && (
      <section><h2>{words.elsewhere}</h2><ul>
        {record.sameAs.map((url) => <li><a href={url} rel="me">{hostPath(url)}</a></li>)}
      </ul></section>
    )}
    <SuggestCorrection title={ui.about} canonical={page.canonical} />
  </article>
</Base>
