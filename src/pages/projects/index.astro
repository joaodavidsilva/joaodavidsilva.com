---
import Base from '../../layouts/Base.astro';
import { SITE_URL } from '../../../site.config.mjs';
import {
  canonicalOf,
  getProjects,
  pathOf,
  PROJECTS_PATH,
  PROJECTS_SUMMARY,
  PROJECTS_TITLE,
  PROJECTS_TWIN_PATH,
  statusLabel,
} from '../../lib/projects';
import '../../styles/projects.css';

const projects = await getProjects();
const canonical = new URL(PROJECTS_PATH, SITE_URL).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: PROJECTS_TITLE,
  description: PROJECTS_SUMMARY,
  inLanguage: 'en',
  url: canonical,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projects.map((project, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: project.data.name,
      url: canonicalOf(project),
    })),
  },
};
---
<Base title={PROJECTS_TITLE} description={PROJECTS_SUMMARY} canonical={canonical} language="en" twin={PROJECTS_TWIN_PATH}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <header>
    <h1>{PROJECTS_TITLE}</h1>
    <p>{PROJECTS_SUMMARY}</p>
  </header>
  <ul class="project-list">
    {projects.map((project) => (
      <li>
        <h2><a href={pathOf(project)}>{project.data.name}</a></h2>
        <p class="project-facts">
          {statusLabel(project.data.status)}{project.data.version && <> · Version {project.data.version}</>}
        </p>
        <p>{project.data.oneLine}</p>
      </li>
    ))}
  </ul>
</Base>
