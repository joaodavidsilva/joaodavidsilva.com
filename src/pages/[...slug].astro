---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Day from '../components/Day.astro';
import SuggestCorrection from '../components/SuggestCorrection.astro';
import HomeSections from '../components/HomeSections.astro';
import { jsonLdBase } from '../lib/metadata';
import { getPages, metadataOf, slugOf, translationsOf, twinPathOf, type Page } from '../lib/pages';
import { originalIdOf, translationJsonLd, type Translations } from '../lib/translations';
import { uiOf } from '../lib/ui';

export async function getStaticPaths() {
  const pages = await getPages();
  return pages.map((page) => ({ params: { slug: slugOf(page) }, props: { page, translations: translationsOf(page, pages) } }));
}

const { page, translations } = Astro.props as { page: Page; translations: Translations };
const meta = metadataOf(page);
const ui = uiOf(meta.language);
const { Content } = await render(page);
const jsonLd = { ...jsonLdBase('WebPage', meta), ...translationJsonLd(translations, 'WebPage') };
// The home page is not a dated document and has no correction link; generic pages keep both.
const home = originalIdOf(page) === 'index';
---
<Base
  title={meta.title}
  description={meta.summary}
  canonical={meta.canonical}
  language={meta.language}
  twin={twinPathOf(page)}
  translations={translations}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class:list={[{ 'home-page': home }, !home && 'container index-page prose']}>
    {home ? <HomeSections page={page} /> : (
      <>
        <header class="long-form-header">
          <h1 class="page-title">{meta.title}</h1>
          <p class="lede">{meta.summary}</p>
          <p class="byline"><span>{ui.published} <Day date={meta.published} /></span></p>
        </header>
        <Content />
        <SuggestCorrection title={meta.title} canonical={meta.canonical} />
      </>
    )}
  </article>
</Base>
