---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SuggestCorrection from '../components/SuggestCorrection.astro';
import { getPages, metadataOf, slugOf, twinPathOf, type Page } from '../lib/pages';

export async function getStaticPaths() {
  const pages = await getPages();
  return pages.map((page) => ({ params: { slug: slugOf(page) }, props: { page } }));
}

const { page } = Astro.props as { page: Page };
const meta = metadataOf(page);
const { Content } = await render(page);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: meta.title,
  headline: meta.title,
  description: meta.summary,
  datePublished: meta.published,
  dateModified: meta.updated,
  inLanguage: meta.language,
  keywords: meta.tags,
  url: meta.canonical,
};
---
<Base
  title={meta.title}
  description={meta.summary}
  canonical={meta.canonical}
  language={meta.language}
  twin={twinPathOf(page)}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <header>
      <h1>{meta.title}</h1>
      <p>{meta.summary}</p>
      <p>Published <time datetime={meta.published}>{meta.published}</time></p>
    </header>
    <Content />
    <SuggestCorrection title={meta.title} canonical={meta.canonical} />
  </article>
</Base>
