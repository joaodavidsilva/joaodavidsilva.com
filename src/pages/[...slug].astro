---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SuggestCorrection from '../components/SuggestCorrection.astro';
import HomeSections from '../components/HomeSections.astro';
import { getPages, metadataOf, slugOf, twinPathOf, type Page } from '../lib/pages';
import { translationsOf, type Translations } from '../lib/translations';

export async function getStaticPaths() {
  const pages = await getPages();
  return pages.map((page) => ({ params: { slug: slugOf(page) }, props: { page, translations: translationsOf(page, pages) } }));
}

const { page, translations } = Astro.props as { page: Page; translations: Translations };
const meta = metadataOf(page);
const { Content } = await render(page);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: meta.title,
  headline: meta.title,
  description: meta.summary,
  datePublished: meta.published,
  dateModified: meta.updated,
  inLanguage: meta.language,
  keywords: meta.tags,
  url: meta.canonical,
  ...(translations.original
    ? { translationOfWork: { '@type': 'WebPage', url: translations.original.canonical } }
    : translations.versions.length > 1
      ? { workTranslation: translations.versions.slice(1).map((v) => ({ '@type': 'WebPage', url: v.canonical, inLanguage: v.language })) }
      : {}),
};
---
<Base
  title={meta.title}
  description={meta.summary}
  canonical={meta.canonical}
  language={meta.language}
  twin={twinPathOf(page)}
  translations={translations}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <header>
      <h1>{meta.title}</h1>
      <p>{meta.summary}</p>
      <p>Published <time datetime={meta.published}>{meta.published}</time></p>
    </header>
    <Content />
    {page.id === 'index' && <HomeSections />}
    <SuggestCorrection title={meta.title} canonical={meta.canonical} />
  </article>
</Base>
