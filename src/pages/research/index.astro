---
import Base from '../../layouts/Base.astro';
import Day from '../../components/Day.astro';
import { getStudies, metadataOf, pathOf, RESEARCH, STATUS_LABELS } from '../../lib/studies';

const studies = (await getStudies()).map((study) => ({ path: pathOf(study), ...metadataOf(study) }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: RESEARCH.title,
  headline: RESEARCH.title,
  description: RESEARCH.summary,
  inLanguage: 'en',
  url: RESEARCH.canonical,
  ...(studies.length > 0 && {
    datePublished: studies.at(-1)!.published,
    dateModified: studies.map((s) => s.updated).sort().at(-1),
  }),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: studies.map((study, i) => ({ '@type': 'ListItem', position: i + 1, url: study.canonical, name: study.title })),
  },
};
---
<Base title={RESEARCH.title} description={RESEARCH.summary} canonical={RESEARCH.canonical} language="en" twin={RESEARCH.twin}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <header>
    <h1>{RESEARCH.title}</h1>
    <p class="summary">{RESEARCH.summary}</p>
  </header>
  {studies.length > 0 ? (
    <ol class="piece-list" reversed>
      {studies.map(({ path, title, summary, published, status, featured }) => (
        <li>
          <article>
            <h2><a href={path}>{title}</a></h2>
            <p class="piece-meta">
              <Day date={published} />
              <span class="status" data-status={status}>{STATUS_LABELS[status]}</span>
              {featured && <span>Featured</span>}
            </p>
            <p>{summary}</p>
          </article>
        </li>
      ))}
    </ol>
  ) : (
    <p>No Studies yet.</p>
  )}
</Base>
