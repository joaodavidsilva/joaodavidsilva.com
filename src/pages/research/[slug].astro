---
import { render } from 'astro:content';
import LongForm from '../../layouts/LongForm.astro';
import DataAndScripts from '../../components/DataAndScripts.astro';
import DiscussedIn from '../../components/DiscussedIn.astro';
import { AUTHOR } from '../../../site.config.mjs';
import * as writing from '../../lib/articles';
import { readingMinutesOf } from '../../lib/own-folder';
import { discussedInOf, getStudies, linksOf, metadataOf, STATUS_LABELS, twinPathOf, type Study } from '../../lib/studies';

export async function getStaticPaths() {
  const [studies, articles] = await Promise.all([getStudies(), writing.getArticles()]);
  return studies.map((study) => ({ params: { slug: study.id }, props: { study, articles } }));
}

interface Props {
  study: Study;
  articles: writing.Article[];
}

const { study, articles } = Astro.props;
const meta = metadataOf(study);
const status = STATUS_LABELS[meta.status];
const discussedIn = discussedInOf(study, articles).map((article) => ({
  path: writing.pathOf(article),
  ...writing.metadataOf(article),
}));
const { Content } = await render(study);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: meta.title,
  description: meta.summary,
  datePublished: meta.published,
  dateModified: meta.updated,
  inLanguage: meta.language,
  keywords: meta.tags,
  url: meta.canonical,
  mainEntityOfPage: meta.canonical,
  creativeWorkStatus: status,
  author: { '@type': 'Person', ...AUTHOR },
  ...(discussedIn.length > 0 && {
    subjectOf: discussedIn.map(({ title, canonical }) => ({ '@type': 'Article', headline: title, url: canonical })),
  }),
};
---
<LongForm
  title={meta.title}
  summary={meta.summary}
  canonical={meta.canonical}
  language={meta.language}
  twin={twinPathOf(study)}
  published={meta.published}
  updated={meta.updated}
  tags={meta.tags}
  readingMinutes={readingMinutesOf(study)}
  jsonLd={jsonLd}
>
  <p slot="header" class="piece-meta"><span>Study</span><span class="status" data-status={meta.status}>Status: {status}</span></p>
  <Content />
  <Fragment slot="after">
    <DataAndScripts {...linksOf(study)} />
    <DiscussedIn articles={discussedIn} />
  </Fragment>
</LongForm>
