---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SuggestCorrection from '../components/SuggestCorrection.astro';
import { dateOf, getNow, NOW, type Now } from '../lib/now';

// A dynamic route so the page exists only when the content set has a Now entry.
export async function getStaticPaths() {
  const now = await getNow();
  return now ? [{ params: { now: 'now' }, props: { now } }] : [];
}

const { now } = Astro.props as { now: Now };
const { Content } = await render(now);
const date = dateOf(now);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: NOW.title,
  description: NOW.summary,
  dateModified: date,
  inLanguage: 'en',
  url: NOW.canonical,
};
---
<Base title={NOW.title} description={NOW.summary} canonical={NOW.canonical} language="en" twin={NOW.twin}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <header>
      <h1>{NOW.title}</h1>
      <p>Updated <time datetime={date}>{date}</time></p>
    </header>
    <Content />
    <SuggestCorrection title={NOW.title} canonical={NOW.canonical} />
  </article>
</Base>
