{
  "name": "joaodavidsilva.com",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "break-ui": "node dev/break-ui/serve.mjs",
    "compare:redesign": "node dev/redesign-compare/compare.mjs",
