    "pdfkit": "0.20.2"
  },
  "devDependencies": {
    "@types/pdfkit": "0.17.7",
    "pagefind": "^1.6.0",
    "pdfjs-dist": "6.5.438",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "sax": "1.6.1",
    "wrangler": "4.158.0"
  }
